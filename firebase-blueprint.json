{
  "entities": {
    "Truyen": {
      "title": "Truyen",
      "description": "Thông tin tác phẩm tiểu thuyết",
      "type": "object",
      "properties": {
        "tenTruyen": { "type": "string", "description": "Tên truyện" },
        "moTa": { "type": "string", "description": "Tóm tắt / giới thiệu truyện" },
        "anhBia": { "type": "string", "description": "URL ảnh bìa dán sẵn link" },
        "theLoai": { "type": "string", "description": "Thể loại truyện" },
        "tacGia": { "type": "string", "description": "Tác giả tác phẩm" },
        "trangThai": { "type": "string", "enum": ["nhap", "daDang"], "description": "Trạng thái nháp hoặc đã đăng" },
        "adminUid": { "type": "string", "description": "UID của admin quản trị" },
        "adminEmail": { "type": "string", "description": "Email admin quản trị" },
        "ngayTao": { "type": "string", "description": "Thời gian tạo ISO string" },
        "ngayCapNhat": { "type": "string", "description": "Thời gian cập nhật" },
        "soChuong": { "type": "number", "description": "Tổng số chương" }
      },
      "required": ["tenTruyen", "trangThai"]
    },
    "Chuong": {
      "title": "Chuong",
      "description": "Nội dung từng chương riêng biệt",
      "type": "object",
      "properties": {
        "soThuTu": { "type": "number", "description": "Số thứ tự chương" },
        "tieuDe": { "type": "string", "description": "Tiêu đề chương" },
        "noiDung": { "type": "string", "description": "Toàn văn nội dung chương" },
        "thoiGianDang": { "type": "string", "description": "Thời gian đăng chương" },
        "truyenId": { "type": "string", "description": "ID truyện cha" }
      },
      "required": ["soThuTu", "tieuDe", "noiDung"]
    },
    "BinhLuan": {
      "title": "BinhLuan",
      "description": "Bình luận và đánh giá của độc giả theo từng truyện",
      "type": "object",
      "properties": {
        "truyenId": { "type": "string", "description": "ID truyện được bình luận" },
        "author": { "type": "string", "description": "Tên người bình luận" },
        "content": { "type": "string", "description": "Nội dung bình luận" },
        "createdAt": { "type": "string", "description": "Ngày tháng năm bình luận hiển thị" },
        "ngayTao": { "type": "string", "description": "Thời gian tạo ISO string để sắp xếp" },
        "likes": { "type": "number", "description": "Số lượt thích" },
        "rating": { "type": "number", "description": "Số sao đánh giá 1-5" },
        "badge": { "type": "string", "description": "Huy hiệu độc giả" },
        "avatar": { "type": "string", "description": "URL ảnh đại diện nếu có" }
      },
      "required": ["truyenId", "author", "content"]
    }
  },
  "firestore": {
    "/truyen/{truyenId}": {
      "schema": "Truyen",
      "description": "Bộ sưu tập các truyện tiểu thuyết"
    },
    "/truyen/{truyenId}/chuong/{chuongId}": {
      "schema": "Chuong",
      "description": "Sub-collection chứa từng chương của truyện"
    },
    "/truyen/{truyenId}/binh_luan/{binhLuanId}": {
      "schema": "BinhLuan",
      "description": "Sub-collection chứa bình luận của độc giả cho từng truyện"
    }
  }
}
